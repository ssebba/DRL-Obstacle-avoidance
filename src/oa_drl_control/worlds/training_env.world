<sdf version="1.6">
  <world name="training_env">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>
    
    <!-- Sun -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Environment geometry, loaded from the .obj mesh -->
    <model name="environment_mesh">
      <pose>0 0 0 1.570796 0 0</pose>
      <static>true</static>
      <link name="link">
        
        <!-- Collision geometry, also seen by the LiDAR -->
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>model://oa_drl_control/worlds/training_env.obj</uri>
            </mesh>
          </geometry>
        </collision>

        <!-- Visual geometry -->
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://oa_drl_control/worlds/training_env.obj</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        
      </link>
    </model>

    <physics type="ode" name="fast_physics">
      <real_time_update_rate>0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

  </world>
</sdf>
